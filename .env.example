# Copy to .env.local (or .env) and fill in real values. Never commit the real file.

# --- MongoDB (required) ---------------------------------------------------
# Local:  mongodb://localhost:27017/
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name (optional, defaults to "my-portfolio")
MONGODB_DB=my-portfolio

# --- Cloudinary (required for image uploads) --------------------------------
# Dashboard → Settings → API Keys. The secret is only ever used on the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder uploads are stored in (optional, defaults to "portfolio")
CLOUDINARY_FOLDER=my-portfolio

# --- Admin provisioning (only needed when running `npm run admin:create`) ---
# Not used by the running site. Remove ADMIN_PASSWORD once the admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Display name for the dashboard (optional)
ADMIN_NAME=
